eclipse.preferences.version=1
gdb.client.commands=set mem inaccessible-by-default off
gdb.client.doCliStart=false
gdb.client.doStart=true
gdb.client.executable=${IDE_ROOT_PATH}/toolchain/gcc/aarch64/bin/aarch64-none-elf-gdb.exe
gdb.client.other=
gdb.openocd.bitstreamFile=${bsp_loc}/platform/PScontrol.bit
gdb.openocd.doInitialReset=false
gdb.openocd.doPreRunReset=false
gdb.openocd.doProgramFPGA=true
gdb.openocd.downloadMode=Hwserver
gdb.openocd.enableSemihosting=false
gdb.openocd.init.other=
gdb.openocd.initialReset.type=
gdb.openocd.preRun.other=
gdb.openocd.preRunReset.type=
gdb.openocd.runPlatInit=true
gdb.server.doStart=true
gdb.server.executable=${IDE_ROOT_PATH}/toolchain/openocd/fpsoc/bin/openocd.exe
gdb.server.other=-f "${IDE_ROOT_PATH}/toolchain/openocd/fpsoc/share/openocd/scripts/target/anlogic/dr1m90.cfg"
